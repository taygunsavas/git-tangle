#!/usr/bin/env bash
set -euo pipefail

LIBEXEC_DIR="$(dirname "$(dirname "$0")")/libexec/tangle"

usage() {
  cat <<'EOF'
Git Tangle 🧶 — Untangle your workflow.

Usage:
  git tangle init
  git tangle config get <key>
  git tangle config set <key> <value>

  git tangle feature start <name> [--from <branch>]
  git tangle feature finish <name>

  git tangle bugfix start <name> [--from <branch>]
  git tangle bugfix finish <name>

  git tangle support start <name> [--from <branch>]
  git tangle support finish <name>

  git tangle release start <version> [--from <branch>]
  git tangle release finish <version>
EOF
}

ensure_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "[tangle] ERROR: not inside a Git repository." >&2
    exit 1
  }
}

detect_default_branch() {
  bash "$LIBEXEC_DIR/utils.sh" tangle::default_branch 2>/dev/null || true
}

prompt() {
  local question="$1" default="${2:-}"
  if [[ -t 0 ]]; then
    if [[ -n "$default" ]]; then
      read -r -p "$question [$default]: " ans || true
      echo "${ans:-$default}"
    else
      read -r -p "$question: " ans || true
      echo "${ans}"
    fi
  else
    echo "$default"
  fi
}

cmd="${1:-}"
if [[ -z "${cmd}" ]]; then usage; exit 1; fi

case "$cmd" in
  init)
    ensure_repo
    def_guess="$(detect_default_branch)"
    [[ -z "$def_guess" ]] && def_guess="main"
    echo "Git Tangle interactive setup"
    def_branch="$(prompt "Default branch name" "$def_guess")"
    tag_prefix="$(prompt "Tag prefix for releases (empty allowed)" "")"
    merge_style="$(prompt "Merge style ('no-ff' or 'ff')" "no-ff")"
    auto_push="$(prompt "Auto push to origin on finish? ('true' or 'false')" "true")"
    rebase_on_finish="$(prompt "Rebase topic onto default before merge? ('true' or 'false')" "false")"
    feature_pref="$(prompt "Feature branch prefix" "feature")"
    bugfix_pref="$(prompt "Bugfix branch prefix" "bugfix")"
    support_pref="$(prompt "Support branch prefix" "support")"
    release_pref="$(prompt "Release branch prefix" "release")"

    git config tangle.defaultBranch "$def_branch"
    git config --unset tangle.tagPrefix >/dev/null 2>&1 || true
    [[ -n "$tag_prefix" ]] && git config tangle.tagPrefix "$tag_prefix"
    git config tangle.mergeStyle "$merge_style"
    git config tangle.autoPush "$auto_push"
    git config tangle.rebaseOnFinish "$rebase_on_finish"
    git config tangle.prefix.feature "$feature_pref"
    git config tangle.prefix.bugfix "$bugfix_pref"
    git config tangle.prefix.support "$support_pref"
    git config tangle.prefix.release "$release_pref"
    echo "[tangle] Initialized repository configuration."
    ;;
  config)
    ensure_repo
    sub="${2:-}"
    case "$sub" in
      get) key="${3:-}"; [[ -z "$key" ]] && {{ echo "[tangle] ERROR: key required."; exit 1; }}; git config --get "$key" || true ;;
      set) key="${3:-}"; val="${4:-}"; [[ -z "$key" || -z "$val" ]] && {{ echo "[tangle] ERROR: key and value required."; exit 1; }}; git config "$key" "$val" ;;
      *) usage; exit 1;;
    esac
    ;;
  feature|bugfix|support|release)
    ensure_repo
    if [[ "$#" -lt 2 ]]; then usage; exit 1; fi
    sub="$2"; shift
    exec "$LIBEXEC_DIR/${cmd}.sh" "$@"
    ;;
  -h|--help|help) usage ;;
  *) usage; exit 1;;
esac